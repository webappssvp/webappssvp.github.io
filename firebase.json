{
  "hosting": [
    {
      "target": "sp",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.*/**",
        "**/*.@(bat|cmd|exe|sh|ps1)",
        "**/node_modules/**",
        "**/*.md",
        "dev/**",
        "dev_local/**",
        "mvp/**",
        "testes/**",
        "privado/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|css|json|webmanifest)",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "**/*.@(svg|png|jpg|jpeg|webp|ico|woff2)",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
        }
      ]
    }
  ]
}
